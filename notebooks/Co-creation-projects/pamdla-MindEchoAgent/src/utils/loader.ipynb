    "\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "def load_mood_music_map():\n",
    "    data_path = Path(__file__).parent.parent.parent / \"data\" / \"mood_music_map.json\"\n",
    "    with open(data_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        return json.load(f)\n"
